# Docker Auto Update System - Production Environment Configuration
# Copy this file to .env.production and customize values

# ==================================================================
# SECURITY SETTINGS (CHANGE THESE IN PRODUCTION!)
# ==================================================================

# JWT Secret - MUST be changed to a secure random string (minimum 32 characters)
JWT_SECRET=production-jwt-secret-key-32-chars-minimum-required-for-security-CHANGE-ME

# Database password (if using PostgreSQL)
POSTGRES_PASSWORD=secure-production-database-password-change-me

# ==================================================================
# APPLICATION CONFIGURATION
# ==================================================================

# Application settings
APP_PORT=8080
APP_ENV=production
LOG_LEVEL=info
LOG_FORMAT=json

# Domain and CORS settings
CORS_ORIGINS=https://your-domain.com,https://app.your-domain.com
DOMAIN=your-domain.com

# ==================================================================
# DATABASE CONFIGURATION
# ==================================================================

# Database type (sqlite, postgres, mysql)
DB_TYPE=postgres
DB_HOST=postgres
DB_PORT=5432
DB_NAME=docker_auto_prod
DB_USER=docker_auto_user
DB_SSL_MODE=disable

# ==================================================================
# DOCKER CONFIGURATION
# ==================================================================

DOCKER_HOST=unix:///var/run/docker.sock
DOCKER_API_VERSION=1.41
DOCKER_TIMEOUT=30

# ==================================================================
# FEATURE FLAGS
# ==================================================================

ENABLE_AUTO_UPDATE=true
ENABLE_NOTIFICATIONS=true
ENABLE_WEBSOCKET=true
ENABLE_TERMINAL=false
ENABLE_METRICS=true
ENABLE_SWAGGER=false

# ==================================================================
# SECURITY SETTINGS
# ==================================================================

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# JWT Configuration
JWT_EXPIRE_HOURS=8
JWT_REFRESH_DAYS=1

# ==================================================================
# PERFORMANCE SETTINGS
# ==================================================================

MAX_CONCURRENT_UPDATES=5
UPDATE_CHECK_INTERVAL=3600
CACHE_TTL=1800
HEALTH_CHECK_INTERVAL=30

# ==================================================================
# SSL/TLS CONFIGURATION (if using HTTPS)
# ==================================================================

SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key
SSL_ENABLED=true

# ==================================================================
# MONITORING AND LOGGING
# ==================================================================

METRICS_PORT=9090
LOG_MAX_SIZE=10M
LOG_MAX_FILES=3

# Timezone
TZ=UTC

# ==================================================================
# BACKUP CONFIGURATION
# ==================================================================

BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
BACKUP_PATH=/app/backups

# ==================================================================
# NOTIFICATION SETTINGS
# ==================================================================

# Email notifications (optional)
SMTP_HOST=smtp.your-domain.com
SMTP_PORT=587
SMTP_USER=notifications@your-domain.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=Docker Auto <notifications@your-domain.com>

# Webhook notifications (optional)
WEBHOOK_URL=https://your-webhook-endpoint.com/docker-auto
WEBHOOK_ENABLED=false